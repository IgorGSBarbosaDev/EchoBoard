<UserControl
    x:Class="EchoBoard.App.Controls.HotkeyCaptureBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch">
    <Grid RowSpacing="{StaticResource EchoBoardSpace8}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="{StaticResource EchoBoardSpace4}">
            <TextBlock
                Text="Modifiers"
                Foreground="{ThemeResource EchoBoardTextSecondaryBrush}"
                FontSize="{StaticResource EchoBoardFontSizeCaption}"
                FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource EchoBoardSpace4}">
                <Border
                    Padding="6,0"
                    Background="{ThemeResource EchoBoardCardBrush}"
                    BorderBrush="{ThemeResource EchoBoardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource EchoBoardRadiusSmall}">
                    <CheckBox
                        AutomationProperties.Name="Control modifier"
                        Content="Ctrl"
                        FontSize="{StaticResource EchoBoardFontSizeCaption}"
                        IsChecked="{x:Bind Ctrl, Mode=TwoWay}"
                        MinHeight="30" />
                </Border>
                <Border
                    Padding="6,0"
                    Background="{ThemeResource EchoBoardCardBrush}"
                    BorderBrush="{ThemeResource EchoBoardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource EchoBoardRadiusSmall}">
                    <CheckBox
                        AutomationProperties.Name="Alt modifier"
                        Content="Alt"
                        FontSize="{StaticResource EchoBoardFontSizeCaption}"
                        IsChecked="{x:Bind Alt, Mode=TwoWay}"
                        MinHeight="30" />
                </Border>
                <Border
                    Padding="6,0"
                    Background="{ThemeResource EchoBoardCardBrush}"
                    BorderBrush="{ThemeResource EchoBoardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource EchoBoardRadiusSmall}">
                    <CheckBox
                        AutomationProperties.Name="Shift modifier"
                        Content="Shift"
                        FontSize="{StaticResource EchoBoardFontSizeCaption}"
                        IsChecked="{x:Bind Shift, Mode=TwoWay}"
                        MinHeight="30" />
                </Border>
                <Border
                    Padding="6,0"
                    Background="{ThemeResource EchoBoardCardBrush}"
                    BorderBrush="{ThemeResource EchoBoardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource EchoBoardRadiusSmall}">
                    <CheckBox
                        AutomationProperties.Name="Windows modifier"
                        Content="Win"
                        FontSize="{StaticResource EchoBoardFontSizeCaption}"
                        IsChecked="{x:Bind Win, Mode=TwoWay}"
                        MinHeight="30" />
                </Border>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="{StaticResource EchoBoardSpace4}">
            <TextBlock
                Text="Primary key"
                Foreground="{ThemeResource EchoBoardTextSecondaryBrush}"
                FontSize="{StaticResource EchoBoardFontSizeCaption}"
                FontWeight="SemiBold" />
            <TextBox
                AutomationProperties.Name="Primary key"
                Height="36"
                Padding="10,4"
                PlaceholderText="F8, S, PageDown"
                Style="{StaticResource EchoBoardSearchTextBoxStyle}"
                Text="{x:Bind PrimaryKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
    </Grid>
</UserControl>
