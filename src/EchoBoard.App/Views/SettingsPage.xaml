<Page
    x:Class="EchoBoard.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EchoBoard.App.Controls"
    Loaded="OnLoaded">
    <Grid x:Name="SettingsRoot" HorizontalAlignment="Stretch">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RefreshMicrophoneButton.(Grid.Row)" Value="1" />
                        <Setter Target="RefreshMicrophoneButton.(Grid.Column)" Value="0" />
                        <Setter Target="RefreshMicrophoneButton.Margin" Value="0,12,0,0" />
                        <Setter Target="SelectedVirtualOutputCombo.(Grid.Row)" Value="1" />
                        <Setter Target="SelectedVirtualOutputCombo.(Grid.Column)" Value="0" />
                        <Setter Target="SelectedVirtualOutputCombo.Margin" Value="0,12,0,0" />
                        <Setter Target="MonitorVolumeSlider.(Grid.Row)" Value="1" />
                        <Setter Target="MonitorVolumeSlider.(Grid.Column)" Value="0" />
                        <Setter Target="VirtualOutputVolumeSlider.(Grid.Row)" Value="2" />
                        <Setter Target="VirtualOutputVolumeSlider.(Grid.Column)" Value="0" />
                        <Setter Target="MixerToggles.Orientation" Value="Vertical" />
                        <Setter Target="MixerToggles.Spacing" Value="8" />
                        <Setter Target="DiagnosticsVirtualOutputDeviceCard.(Grid.Row)" Value="1" />
                        <Setter Target="DiagnosticsVirtualOutputDeviceCard.(Grid.Column)" Value="0" />
                        <Setter Target="DiagnosticsEffectsMeter.(Grid.Row)" Value="1" />
                        <Setter Target="DiagnosticsEffectsMeter.(Grid.Column)" Value="0" />
                        <Setter Target="DiagnosticsMonitorMeter.(Grid.Row)" Value="2" />
                        <Setter Target="DiagnosticsMonitorMeter.(Grid.Column)" Value="0" />
                        <Setter Target="DiagnosticsVirtualOutputMeter.(Grid.Row)" Value="3" />
                        <Setter Target="DiagnosticsVirtualOutputMeter.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Stretch" Spacing="{StaticResource EchoBoardSpace24}">
            <StackPanel Spacing="{StaticResource EchoBoardSpace8}">
                <TextBlock
                    Text="{Binding Title}"
                    Foreground="{ThemeResource EchoBoardTextPrimaryBrush}"
                    FontSize="{StaticResource EchoBoardFontSizeTitle}"
                    FontWeight="SemiBold" />
                <TextBlock
                    Text="{Binding Subtitle}"
                    Style="{StaticResource EchoBoardCaptionTextStyle}" />
            </StackPanel>

            <Border Style="{StaticResource EchoBoardPanelStyle}">
                <StackPanel Spacing="{StaticResource EchoBoardSpace12}">
                    <TextBlock Text="Microphone input" Style="{StaticResource EchoBoardSectionTitleTextStyle}" />
                    <TextBlock
                        Text="Select the physical input mixed continuously with sound effects."
                        Style="{StaticResource EchoBoardCaptionTextStyle}" />

                    <Grid x:Name="MicrophoneSelectionGrid" ColumnSpacing="{StaticResource EchoBoardSpace16}" RowSpacing="{StaticResource EchoBoardSpace12}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox
                            MinWidth="0"
                            AutomationProperties.Name="Microphone device"
                            ItemsSource="{Binding MicrophoneDevices}"
                            DisplayMemberPath="DisplayName"
                            SelectedItem="{Binding SelectedMicrophoneDevice, Mode=TwoWay}"
                            PlaceholderText="Choose microphone" />
                        <Button
                            x:Name="RefreshMicrophoneButton"
                            Grid.Column="1"
                            Content="Refresh"
                            Command="{Binding RefreshMicrophoneDevicesCommand}"
                            Style="{StaticResource EchoBoardSecondaryButtonStyle}" />
                    </Grid>

                    <controls:DeviceStatusBadge
                        Label="Selected microphone"
                        DeviceName="{Binding SelectedMicrophoneName}"
                        Icon="Microphone"
                        Status="{Binding MicrophoneStatusKind}" />

                    <StackPanel Spacing="{StaticResource EchoBoardSpace12}">
                        <controls:AudioLevelMeter
                            Height="52"
                            HorizontalAlignment="Stretch"
                            Label="Input level"
                            Level="{Binding MicrophoneLevel}"
                            Variant="Microphone"
                            ValueText="{Binding MicrophoneLevelText}" />
                        <Grid ColumnSpacing="{StaticResource EchoBoardSpace16}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:VolumeSlider
                                Label="Mic gain"
                                Icon="Microphone"
                                Value="{Binding MicrophoneGainPercent, Mode=TwoWay}"
                                IsReadOnly="False" />
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Content="{Binding MicrophoneMuteButtonText}"
                                Command="{Binding ToggleMicrophoneMuteCommand}"
                                Style="{StaticResource EchoBoardSecondaryButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource EchoBoardPanelStyle}">
                <StackPanel Spacing="{StaticResource EchoBoardSpace16}">
                    <StackPanel Spacing="{StaticResource EchoBoardSpace4}">
                        <TextBlock Text="Mixer and routing" Style="{StaticResource EchoBoardSectionTitleTextStyle}" />
                        <TextBlock Text="{Binding RoutingStatusText}" Style="{StaticResource EchoBoardCaptionTextStyle}" />
                    </StackPanel>

                    <Grid x:Name="MixerDevicesGrid" ColumnSpacing="{StaticResource EchoBoardSpace16}" RowSpacing="{StaticResource EchoBoardSpace12}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            Header="Local monitor"
                            ItemsSource="{Binding MonitorDevices}"
                            DisplayMemberPath="DisplayName"
                            SelectedItem="{Binding SelectedMonitorDevice, Mode=TwoWay}"
                            PlaceholderText="Windows default output" />
                        <ComboBox
                            x:Name="SelectedVirtualOutputCombo"
                            Grid.Column="1"
                            Header="Virtual output"
                            ItemsSource="{Binding VirtualOutputDevices}"
                            DisplayMemberPath="DisplayName"
                            SelectedItem="{Binding SelectedVirtualOutputDevice, Mode=TwoWay}"
                            PlaceholderText="Select VB-CABLE or VoiceMeeter" />
                    </Grid>

                    <Border
                        MaxWidth="720"
                        Padding="10,8"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource EchoBoardCardActiveBrush}"
                        BorderBrush="{ThemeResource EchoBoardWarningBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding VirtualOutputWarningVisibility}">
                        <TextBlock
                            Text="{Binding VirtualOutputWarningText}"
                            Style="{StaticResource EchoBoardCaptionTextStyle}"
                            TextWrapping="Wrap" />
                    </Border>

                    <Grid x:Name="MixerVolumesGrid" ColumnSpacing="{StaticResource EchoBoardSpace16}" RowSpacing="{StaticResource EchoBoardSpace12}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:VolumeSlider
                            x:Name="EffectsVolumeSlider"
                            Label="Effects"
                            Icon="Audio"
                            Value="{Binding EffectsVolumePercent, Mode=TwoWay}"
                            IsReadOnly="False" />
                        <controls:VolumeSlider
                            x:Name="MonitorVolumeSlider"
                            Grid.Column="1"
                            Label="Monitor"
                            Icon="Audio"
                            Value="{Binding MonitorVolumePercent, Mode=TwoWay}"
                            IsReadOnly="False" />
                        <controls:VolumeSlider
                            x:Name="VirtualOutputVolumeSlider"
                            Grid.Column="2"
                            Label="Virtual output"
                            Icon="Audio"
                            Value="{Binding VirtualOutputVolumePercent, Mode=TwoWay}"
                            IsReadOnly="False" />
                    </Grid>

                    <StackPanel x:Name="MixerToggles" Orientation="Horizontal" Spacing="{StaticResource EchoBoardSpace24}">
                        <ToggleSwitch Header="Local monitor" IsOn="{Binding IsMonitorEnabled, Mode=TwoWay}" />
                        <ToggleSwitch Header="Mute effects" IsOn="{Binding AreEffectsMuted, Mode=TwoWay}" />
                        <ToggleSwitch Header="Mute monitor" IsOn="{Binding IsMonitorMuted, Mode=TwoWay}" />
                        <ToggleSwitch Header="Mute virtual output" IsOn="{Binding IsVirtualOutputMuted, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                DataContext="{Binding AudioDiagnostics}"
                Style="{StaticResource EchoBoardPanelStyle}">
                <StackPanel Spacing="{StaticResource EchoBoardSpace16}">
                    <StackPanel Spacing="{StaticResource EchoBoardSpace4}">
                        <TextBlock Text="Audio diagnostics" Style="{StaticResource EchoBoardSectionTitleTextStyle}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource EchoBoardCaptionTextStyle}" />
                    </StackPanel>

                    <StackPanel Spacing="{StaticResource EchoBoardSpace4}">
                        <TextBlock Text="{Binding EmptyStateTitle}" Style="{StaticResource EchoBoardSectionTitleTextStyle}" />
                        <TextBlock Text="{Binding EmptyStateMessage}" Style="{StaticResource EchoBoardBodyTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>

                    <controls:DeviceStatusBadge
                        Label="{Binding MicrophoneDevice.Label}"
                        DeviceName="{Binding MicrophoneDevice.DeviceName}"
                        Icon="{Binding MicrophoneDevice.Icon}"
                        Status="{Binding MicrophoneDevice.Status}" />

                    <Grid x:Name="DiagnosticsDeviceCardsGrid" ColumnSpacing="{StaticResource EchoBoardSpace12}" RowSpacing="{StaticResource EchoBoardSpace12}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:DeviceStatusBadge
                            Label="{Binding MonitorDevice.Label}"
                            DeviceName="{Binding MonitorDevice.DeviceName}"
                            Icon="{Binding MonitorDevice.Icon}"
                            Status="{Binding MonitorDevice.Status}" />
                        <controls:DeviceStatusBadge
                            x:Name="DiagnosticsVirtualOutputDeviceCard"
                            Grid.Column="1"
                            Label="{Binding VirtualOutputDevice.Label}"
                            DeviceName="{Binding VirtualOutputDevice.DeviceName}"
                            Icon="{Binding VirtualOutputDevice.Icon}"
                            Status="{Binding VirtualOutputDevice.Status}" />
                    </Grid>

                    <Grid x:Name="DiagnosticsMetersGrid" ColumnSpacing="{StaticResource EchoBoardSpace12}" RowSpacing="{StaticResource EchoBoardSpace12}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:AudioLevelMeter
                            Label="{Binding MicrophoneMeter.Label}"
                            Level="{Binding MicrophoneMeter.Level}"
                            Variant="{Binding MicrophoneMeter.Variant}"
                            ValueText="{Binding MicrophoneMeter.ValueText}" />
                        <controls:AudioLevelMeter
                            x:Name="DiagnosticsEffectsMeter"
                            Grid.Column="1"
                            Label="{Binding EffectsMeter.Label}"
                            Level="{Binding EffectsMeter.Level}"
                            Variant="{Binding EffectsMeter.Variant}"
                            ValueText="{Binding EffectsMeter.ValueText}" />
                        <controls:AudioLevelMeter
                            x:Name="DiagnosticsMonitorMeter"
                            Grid.Row="1"
                            Label="{Binding MonitorMeter.Label}"
                            Level="{Binding MonitorMeter.Level}"
                            Variant="{Binding MonitorMeter.Variant}"
                            ValueText="{Binding MonitorMeter.ValueText}" />
                        <controls:AudioLevelMeter
                            x:Name="DiagnosticsVirtualOutputMeter"
                            Grid.Row="1"
                            Grid.Column="1"
                            Label="{Binding VirtualOutputMeter.Label}"
                            Level="{Binding VirtualOutputMeter.Level}"
                            Variant="{Binding VirtualOutputMeter.Variant}"
                            ValueText="{Binding VirtualOutputMeter.ValueText}" />
                    </Grid>

                    <StackPanel Spacing="{StaticResource EchoBoardSpace4}">
                        <TextBlock Text="{Binding MixerStateText}" Style="{StaticResource EchoBoardSectionTitleTextStyle}" />
                        <TextBlock Text="{Binding FormatText}" Style="{StaticResource EchoBoardCaptionTextStyle}" />
                        <TextBlock Text="{Binding MonitorRouteText}" Style="{StaticResource EchoBoardCaptionTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding VirtualOutputRouteText}" Style="{StaticResource EchoBoardCaptionTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LastErrorText}" Style="{StaticResource EchoBoardBodyTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
