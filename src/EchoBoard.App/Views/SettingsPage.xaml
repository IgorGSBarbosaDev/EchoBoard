<Page
    x:Class="EchoBoard.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EchoBoard.App.Controls"
    Loaded="OnLoaded">
    <Grid x:Name="SettingsRoot" HorizontalAlignment="Stretch">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RefreshMicrophoneButton.(Grid.Row)" Value="1" />
                        <Setter Target="RefreshMicrophoneButton.(Grid.Column)" Value="0" />
                        <Setter Target="RefreshMicrophoneButton.Margin" Value="0,12,0,0" />
                        <Setter Target="SelectedVirtualOutputCombo.(Grid.Row)" Value="1" />
                        <Setter Target="SelectedVirtualOutputCombo.(Grid.Column)" Value="0" />
                        <Setter Target="SelectedVirtualOutputCombo.Margin" Value="0,12,0,0" />
                        <Setter Target="MonitorVolumeSlider.(Grid.Row)" Value="1" />
                        <Setter Target="MonitorVolumeSlider.(Grid.Column)" Value="0" />
                        <Setter Target="VirtualOutputVolumeSlider.(Grid.Row)" Value="2" />
                        <Setter Target="VirtualOutputVolumeSlider.(Grid.Column)" Value="0" />
                        <Setter Target="MixerToggles.Orientation" Value="Vertical" />
                        <Setter Target="MixerToggles.Spacing" Value="8" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Stretch" Spacing="{StaticResource EchoBoardSpace24}">
            <StackPanel Spacing="{StaticResource EchoBoardSpace8}">
                <TextBlock
                    Text="{Binding Title}"
                    Foreground="{ThemeResource EchoBoardTextPrimaryBrush}"
                    FontSize="{StaticResource EchoBoardFontSizeTitle}"
                    FontWeight="SemiBold" />
                <TextBlock
                    Text="{Binding Subtitle}"
                    Style="{StaticResource EchoBoardCaptionTextStyle}" />
            </StackPanel>

            <Border Style="{StaticResource EchoBoardPanelStyle}">
                <StackPanel Spacing="{StaticResource EchoBoardSpace12}">
                    <TextBlock Text="Microphone input" Style="{StaticResource EchoBoardSectionTitleTextStyle}" />
                    <TextBlock
                        Text="Select the physical input mixed continuously with sound effects."
                        Style="{StaticResource EchoBoardCaptionTextStyle}" />

                    <Grid x:Name="MicrophoneSelectionGrid" ColumnSpacing="{StaticResource EchoBoardSpace16}" RowSpacing="{StaticResource EchoBoardSpace12}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox
                            MinWidth="0"
                            AutomationProperties.Name="Microphone device"
                            ItemsSource="{Binding MicrophoneDevices}"
                            DisplayMemberPath="DisplayName"
                            SelectedItem="{Binding SelectedMicrophoneDevice, Mode=TwoWay}"
                            PlaceholderText="Choose microphone" />
                        <Button
                            x:Name="RefreshMicrophoneButton"
                            Grid.Column="1"
                            Content="Refresh"
                            Command="{Binding RefreshMicrophoneDevicesCommand}"
                            Style="{StaticResource EchoBoardSecondaryButtonStyle}" />
                    </Grid>

                    <controls:DeviceStatusBadge
                        Label="Selected microphone"
                        DeviceName="{Binding SelectedMicrophoneName}"
                        Icon="Microphone"
                        Status="{Binding MicrophoneStatusKind}" />

                    <StackPanel Spacing="{StaticResource EchoBoardSpace12}">
                        <controls:AudioLevelMeter
                            Height="52"
                            HorizontalAlignment="Stretch"
                            Label="Input level"
                            Level="{Binding MicrophoneLevel}"
                            Variant="Microphone"
                            ValueText="{Binding MicrophoneLevelText}" />
                        <Grid ColumnSpacing="{StaticResource EchoBoardSpace16}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:VolumeSlider
                                Label="Mic gain"
                                Icon="Microphone"
                                Value="{Binding MicrophoneGainPercent, Mode=TwoWay}"
                                IsReadOnly="False" />
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Content="{Binding MicrophoneMuteButtonText}"
                                Command="{Binding ToggleMicrophoneMuteCommand}"
                                Style="{StaticResource EchoBoardSecondaryButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource EchoBoardPanelStyle}">
                <StackPanel Spacing="{StaticResource EchoBoardSpace16}">
                    <StackPanel Spacing="{StaticResource EchoBoardSpace4}">
                        <TextBlock Text="Mixer and routing" Style="{StaticResource EchoBoardSectionTitleTextStyle}" />
                        <TextBlock Text="{Binding RoutingStatusText}" Style="{StaticResource EchoBoardCaptionTextStyle}" />
                    </StackPanel>

                    <Grid x:Name="MixerDevicesGrid" ColumnSpacing="{StaticResource EchoBoardSpace16}" RowSpacing="{StaticResource EchoBoardSpace12}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            Header="Local monitor"
                            ItemsSource="{Binding MonitorDevices}"
                            DisplayMemberPath="DisplayName"
                            SelectedItem="{Binding SelectedMonitorDevice, Mode=TwoWay}"
                            PlaceholderText="Windows default output" />
                        <ComboBox
                            x:Name="SelectedVirtualOutputCombo"
                            Grid.Column="1"
                            Header="Virtual output"
                            ItemsSource="{Binding VirtualOutputDevices}"
                            DisplayMemberPath="DisplayName"
                            SelectedItem="{Binding SelectedVirtualOutputDevice, Mode=TwoWay}"
                            PlaceholderText="Select VB-CABLE or VoiceMeeter" />
                    </Grid>

                    <Border
                        MaxWidth="720"
                        Padding="10,8"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource EchoBoardCardActiveBrush}"
                        BorderBrush="{ThemeResource EchoBoardWarningBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding VirtualOutputWarningVisibility}">
                        <TextBlock
                            Text="{Binding VirtualOutputWarningText}"
                            Style="{StaticResource EchoBoardCaptionTextStyle}"
                            TextWrapping="Wrap" />
                    </Border>

                    <Grid x:Name="MixerVolumesGrid" ColumnSpacing="{StaticResource EchoBoardSpace16}" RowSpacing="{StaticResource EchoBoardSpace12}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:VolumeSlider
                            x:Name="EffectsVolumeSlider"
                            Label="Effects"
                            Icon="Audio"
                            Value="{Binding EffectsVolumePercent, Mode=TwoWay}"
                            IsReadOnly="False" />
                        <controls:VolumeSlider
                            x:Name="MonitorVolumeSlider"
                            Grid.Column="1"
                            Label="Monitor"
                            Icon="Audio"
                            Value="{Binding MonitorVolumePercent, Mode=TwoWay}"
                            IsReadOnly="False" />
                        <controls:VolumeSlider
                            x:Name="VirtualOutputVolumeSlider"
                            Grid.Column="2"
                            Label="Virtual output"
                            Icon="Audio"
                            Value="{Binding VirtualOutputVolumePercent, Mode=TwoWay}"
                            IsReadOnly="False" />
                    </Grid>

                    <StackPanel x:Name="MixerToggles" Orientation="Horizontal" Spacing="{StaticResource EchoBoardSpace24}">
                        <ToggleSwitch Header="Local monitor" IsOn="{Binding IsMonitorEnabled, Mode=TwoWay}" />
                        <ToggleSwitch Header="Mute effects" IsOn="{Binding AreEffectsMuted, Mode=TwoWay}" />
                        <ToggleSwitch Header="Mute monitor" IsOn="{Binding IsMonitorMuted, Mode=TwoWay}" />
                        <ToggleSwitch Header="Mute virtual output" IsOn="{Binding IsVirtualOutputMuted, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource EchoBoardPanelStyle}">
                <StackPanel Spacing="{StaticResource EchoBoardSpace12}">
                    <TextBlock Text="Global hotkeys" Style="{StaticResource EchoBoardSectionTitleTextStyle}" />
                    <TextBlock
                        Text="Keyboard shortcuts work while EchoBoard is minimized or out of focus. Use at least one modifier plus one primary key."
                        Style="{StaticResource EchoBoardCaptionTextStyle}" />
                    <controls:ToastNotification
                        Kind="{Binding FeedbackToast.Kind}"
                        Title="{Binding FeedbackToast.Title}"
                        Description="{Binding FeedbackToast.Description}"
                        Visibility="{Binding FeedbackToastVisibility}" />
                    <ItemsControl ItemsSource="{Binding GlobalHotkeys}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,12"
                                    Style="{StaticResource EchoBoardCardStyle}">
                                    <Grid ColumnSpacing="{StaticResource EchoBoardSpace16}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="280" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="{StaticResource EchoBoardSpace4}">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource EchoBoardSectionTitleTextStyle}" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource EchoBoardCaptionTextStyle}" />
                                            <controls:HotkeyBadge Text="{Binding HotkeyText}" />
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource EchoBoardCaptionTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="{StaticResource EchoBoardSpace8}">
                                            <controls:HotkeyCaptureBox
                                                Ctrl="{Binding Ctrl, Mode=TwoWay}"
                                                Alt="{Binding Alt, Mode=TwoWay}"
                                                Shift="{Binding Shift, Mode=TwoWay}"
                                                Win="{Binding Win, Mode=TwoWay}"
                                                PrimaryKey="{Binding PrimaryKey, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Spacing="{StaticResource EchoBoardSpace8}">
                                            <Button
                                                Content="Save"
                                                Command="{Binding SaveCommand}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource EchoBoardSecondaryButtonStyle}" />
                                            <Button
                                                Content="{Binding ToggleEnabledText}"
                                                Command="{Binding ToggleEnabledCommand}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource EchoBoardSecondaryButtonStyle}" />
                                            <Button
                                                Content="Remove"
                                                Command="{Binding RemoveCommand}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource EchoBoardSecondaryButtonStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
