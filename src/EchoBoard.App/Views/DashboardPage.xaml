<Page
    x:Class="EchoBoard.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EchoBoard.App.Controls"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <Grid
        HorizontalAlignment="Stretch">
        <ScrollViewer
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                HorizontalAlignment="Stretch"
                Spacing="14">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="Início"
                        Foreground="{ThemeResource EchoBoardTextPrimaryBrush}"
                        FontSize="24"
                        FontWeight="SemiBold" />
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <Button
                            Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource EchoBoardSecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <SymbolIcon Symbol="Setting" />
                                <TextBlock Text="Configurar áudio" />
                            </StackPanel>
                        </Button>
                        <Button
                            Click="OnImportClicked"
                            Style="{StaticResource EchoBoardPrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <SymbolIcon Symbol="Add" />
                                <TextBlock Text="Importar sons" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock
                    Text="{Binding FeedbackMessage}"
                    Foreground="{ThemeResource EchoBoardTextSecondaryBrush}"
                    Visibility="{Binding FeedbackVisibility}" />

                <Border Style="{StaticResource EchoBoardPanelStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Acesso rápido" Style="{StaticResource EchoBoardSectionTitleTextStyle}" />
                                <TextBlock Text="Favoritos e sons usados com frequência." Style="{StaticResource EchoBoardCaptionTextStyle}" />
                            </StackPanel>
                            <Button
                                HorizontalAlignment="Right"
                                Command="{Binding OpenLibraryCommand}"
                                Content="Abrir biblioteca →"
                                Style="{StaticResource EchoBoardSecondaryButtonStyle}" />
                        </Grid>
                        <GridView
                            ItemsSource="{Binding QuickSounds}"
                            SelectionMode="None"
                            IsItemClickEnabled="False"
                            Visibility="{Binding QuickSoundsVisibility}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid
                                        Orientation="Horizontal"
                                        MaximumRowsOrColumns="4"
                                        ItemWidth="240" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <controls:SoundCard
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,10,10"
                                        Title="{Binding Title}"
                                        DurationText="{Binding DurationText}"
                                        HotkeyText="{Binding HotkeyText}"
                                        CategoryLabel="{Binding CategoryLabel}"
                                        IsPlaying="{Binding IsPlaying}"
                                        IsPaused="{Binding IsPaused}"
                                        IsFavorite="{Binding IsFavorite}"
                                        IsMissingFile="{Binding IsMissingFile}"
                                        StatusText="{Binding StatusText}"
                                        Command="{Binding SelectCommand}"
                                        CommandParameter="{Binding Id}"
                                        FavoriteCommand="{Binding FavoriteCommand}"
                                        FavoriteCommandParameter="{Binding Id}"
                                        FormatText="{Binding FormatText}"
                                        UsageText="{Binding UsageText}"
                                        WaveformBars="{Binding WaveformBars}"
                                        DetailsCommand="{Binding DetailsCommand}"
                                        EditCommand="{Binding EditCommand}"
                                        DeleteCommand="{Binding DeleteCommand}" />
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                        <StackPanel
                            HorizontalAlignment="Center"
                            Spacing="5"
                            Visibility="{Binding QuickEmptyVisibility}">
                            <SymbolIcon Symbol="Audio" Foreground="{ThemeResource EchoBoardActionBrush}" />
                            <TextBlock Text="Nenhum som disponível" FontWeight="SemiBold" />
                            <TextBlock Text="Importe sons para preencher o acesso rápido." Style="{StaticResource EchoBoardCaptionTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid
                    x:Name="AudioSectionsLayout"
                    ColumnSpacing="14"
                    RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="WideAudioSections">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="960" />
                                </VisualState.StateTriggers>
                            </VisualState>
                            <VisualState x:Name="CompactAudioSections">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="0" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="FlowAudioPanel.(Grid.ColumnSpan)" Value="2" />
                                    <Setter Target="LiveLevelsPanel.(Grid.Row)" Value="1" />
                                    <Setter Target="LiveLevelsPanel.(Grid.Column)" Value="0" />
                                    <Setter Target="LiveLevelsPanel.(Grid.ColumnSpan)" Value="2" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>

                    <Border
                        x:Name="FlowAudioPanel"
                        Style="{StaticResource EchoBoardPanelStyle}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Fluxo de áudio" Style="{StaticResource EchoBoardSectionTitleTextStyle}" />
                                    <TextBlock Text="Leitura direta de como o sinal entra, é misturado e sai." Style="{StaticResource EchoBoardCaptionTextStyle}" />
                                </StackPanel>
                                <Button
                                    HorizontalAlignment="Right"
                                    Command="{Binding OpenSettingsCommand}"
                                    Content="Editar rota"
                                    Style="{StaticResource EchoBoardSecondaryButtonStyle}" />
                            </Grid>
                            <StackPanel Spacing="8">
                                <Border HorizontalAlignment="Stretch" Style="{StaticResource EchoBoardCardStyle}">
                                    <StackPanel Spacing="7">
                                        <SymbolIcon HorizontalAlignment="Left" Symbol="Microphone" Foreground="{ThemeResource EchoBoardActionBrush}" />
                                        <TextBlock Text="{Binding MicrophoneNote}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="Entrada física" Style="{StaticResource EchoBoardCaptionTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="→"
                                    Foreground="{ThemeResource EchoBoardTextSecondaryBrush}"
                                    FontSize="18" />
                                <Border HorizontalAlignment="Stretch" Style="{StaticResource EchoBoardCardStyle}">
                                    <StackPanel Spacing="7">
                                        <SymbolIcon HorizontalAlignment="Left" Symbol="Audio" Foreground="{ThemeResource EchoBoardActionBrush}" />
                                        <TextBlock Text="Mixer EchoBoard" FontWeight="SemiBold" />
                                        <TextBlock Text="Voz + efeitos" Foreground="{ThemeResource EchoBoardSuccessBrush}" FontSize="10" />
                                    </StackPanel>
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="→"
                                    Foreground="{ThemeResource EchoBoardTextSecondaryBrush}"
                                    FontSize="18" />
                                <Border HorizontalAlignment="Stretch" Style="{StaticResource EchoBoardCardStyle}">
                                    <StackPanel Spacing="7">
                                        <SymbolIcon HorizontalAlignment="Left" Symbol="Audio" Foreground="{ThemeResource EchoBoardWarningBrush}" />
                                        <TextBlock Text="Saída virtual" FontWeight="SemiBold" />
                                        <TextBlock Text="VB-CABLE / externo" Foreground="{ThemeResource EchoBoardWarningBrush}" FontSize="10" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="LiveLevelsPanel"
                        Grid.Column="1"
                        Style="{StaticResource EchoBoardPanelStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Níveis ao vivo" Style="{StaticResource EchoBoardSectionTitleTextStyle}" />
                                <TextBlock Text="Dados reais quando a telemetria está disponível." Style="{StaticResource EchoBoardCaptionTextStyle}" />
                            </StackPanel>
                            <controls:AudioLevelMeter Label="Microfone" Level="{Binding MicrophoneLevel}" ValueText="{Binding MicrophoneLevelText}" Variant="Microphone" />
                            <controls:AudioLevelMeter Label="Efeitos" Level="{Binding EffectsLevel}" ValueText="{Binding EffectsLevelText}" Variant="Effects" />
                            <controls:AudioLevelMeter Label="Saída virtual" Level="{Binding VirtualOutputLevel}" ValueText="{Binding VirtualOutputLevelText}" Variant="VirtualOutput" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
