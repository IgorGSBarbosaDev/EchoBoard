<ContentDialog
    x:Class="EchoBoard.App.Dialogs.CategoryManagementDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Manage categories"
    PrimaryButtonText="{Binding CategoryManagementPrimaryButtonText}"
    IsPrimaryButtonEnabled="{Binding CategoryManagementPrimaryButtonEnabled}"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Opened="OnOpened"
    Closing="OnClosing"
    Closed="OnClosed"
    PrimaryButtonClick="OnPrimaryButtonClick">
    <Grid MaxWidth="760" MinWidth="400">
        <StackPanel Spacing="{StaticResource EchoBoardSpace16}" Visibility="{Binding CategoryManagementListVisibility}">
            <TextBlock
                Text="Choose an existing category to edit or delete."
                Style="{StaticResource EchoBoardBodyTextStyle}"
                TextWrapping="Wrap" />

            <ProgressRing
                IsActive="{Binding IsCategoryManagementLoading}"
                IsIndeterminate="True"
                HorizontalAlignment="Center"
                Visibility="{Binding CategoryManagementLoadingVisibility}" />
            <TextBlock
                Text="{Binding CategoryManagementError}"
                Foreground="{ThemeResource EchoBoardErrorBrush}"
                TextWrapping="Wrap"
                Visibility="{Binding CategoryManagementErrorVisibility}" />
            <TextBlock
                Text="No categories yet. Create one to organize your sounds."
                Style="{StaticResource EchoBoardCaptionTextStyle}"
                Visibility="{Binding CategoryManagementEmptyVisibility}" />

            <Border
                MaxHeight="360"
                Style="{StaticResource EchoBoardPanelStyle}"
                Padding="4"
                Visibility="{Binding CategoryManagementItemsVisibility}">
                <ListView
                    ItemsSource="{Binding ManagedCategories}"
                    SelectionMode="None"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollMode="Enabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="52" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="{Binding Name}"
                                    Foreground="{ThemeResource EchoBoardTextPrimaryBrush}"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding CountText}"
                                    Style="{StaticResource EchoBoardCaptionTextStyle}"
                                    VerticalAlignment="Center" />
                                <Button
                                    Grid.Column="2"
                                    Style="{StaticResource EchoBoardCardActionButtonStyle}"
                                    Command="{Binding EditCommand}"
                                    CommandParameter="{Binding Id}"
                                    AutomationProperties.Name="{Binding EditAutomationName}"
                                    ToolTipService.ToolTip="Edit category">
                                    <FontIcon Glyph="&#xE70F;" />
                                </Button>
                                <Button
                                    Grid.Column="3"
                                    Style="{StaticResource EchoBoardCardActionButtonStyle}"
                                    Foreground="{ThemeResource EchoBoardErrorBrush}"
                                    Command="{Binding DeleteCommand}"
                                    CommandParameter="{Binding Id}"
                                    AutomationProperties.Name="{Binding DeleteAutomationName}"
                                    ToolTipService.ToolTip="Delete category">
                                    <FontIcon Glyph="&#xE74D;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border
                Style="{StaticResource EchoBoardCardStyle}"
                Padding="16"
                Visibility="{Binding CategoryDeletionConfirmationVisibility}">
                <StackPanel Spacing="{StaticResource EchoBoardSpace12}">
                    <TextBlock Text="Delete category?" Style="{StaticResource EchoBoardSectionTitleTextStyle}" />
                    <TextBlock
                        Text="{Binding CategoryDeletionDescription}"
                        Style="{StaticResource EchoBoardBodyTextStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding CategoryDeletionError}"
                        Foreground="{ThemeResource EchoBoardErrorBrush}"
                        TextWrapping="Wrap"
                        Visibility="{Binding CategoryDeletionErrorVisibility}" />
                    <ProgressRing
                        IsActive="{Binding IsCategoryDeletionSaving}"
                        IsIndeterminate="True"
                        HorizontalAlignment="Center"
                        Visibility="{Binding CategoryDeletionSavingVisibility}" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource EchoBoardSpace8}">
                        <Button
                            Content="Delete category"
                            Command="{Binding ConfirmCategoryDeletionCommand}"
                            IsEnabled="{Binding CategoryDeletionSaveEnabled}"
                            Style="{StaticResource EchoBoardDangerButtonStyle}" />
                        <Button
                            Content="Cancel"
                            Command="{Binding CancelCategoryDeletionCommand}"
                            IsEnabled="{Binding CategoryDeletionCancelEnabled}"
                            Style="{StaticResource EchoBoardSecondaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Spacing="{StaticResource EchoBoardSpace16}" Visibility="{Binding CategoryManagementEditorVisibility}">
            <TextBlock Text="{Binding CategoryEditorTitle}" Style="{StaticResource EchoBoardSectionTitleTextStyle}" />
            <TextBox
                x:Name="CategoryNameTextBox"
                Header="Category name"
                PlaceholderText="Memes"
                Text="{Binding CategoryEditorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                Text="{Binding CategoryEditorError}"
                Foreground="{ThemeResource EchoBoardErrorBrush}"
                TextWrapping="Wrap"
                Visibility="{Binding CategoryEditorErrorVisibility}" />
            <ProgressRing
                IsActive="{Binding IsCategoryEditorSaving}"
                IsIndeterminate="True"
                HorizontalAlignment="Center"
                Visibility="{Binding CategoryEditorSavingVisibility}" />

            <TextBlock Text="Sounds" Style="{StaticResource EchoBoardSectionTitleTextStyle}" />
            <ProgressRing
                IsActive="{Binding IsCategoryEditorLoading}"
                IsIndeterminate="True"
                HorizontalAlignment="Center"
                Visibility="{Binding CategoryEditorLoadingVisibility}" />
            <TextBlock
                Text="No sounds have been imported yet."
                Style="{StaticResource EchoBoardCaptionTextStyle}"
                Visibility="{Binding CategoryEditorEmptyVisibility}" />
            <Border
                MaxHeight="340"
                Style="{StaticResource EchoBoardPanelStyle}"
                Padding="4"
                Visibility="{Binding CategoryEditorListVisibility}">
                <ListView
                    ItemsSource="{Binding CategoryEditorSounds}"
                    SelectionMode="None"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollMode="Enabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="48" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                    AutomationProperties.Name="{Binding SelectionAutomationName}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding Name}"
                                    Foreground="{ThemeResource EchoBoardTextPrimaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center" />
                                <Button
                                    Grid.Column="2"
                                    Style="{StaticResource EchoBoardCardActionButtonStyle}"
                                    Command="{Binding PreviewCommand}"
                                    CommandParameter="{Binding Id}"
                                    IsEnabled="{Binding CanPreview}"
                                    AutomationProperties.Name="{Binding PreviewAutomationName}"
                                    ToolTipService.ToolTip="Preview sound">
                                    <FontIcon Glyph="&#xE768;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>
    </Grid>
</ContentDialog>
