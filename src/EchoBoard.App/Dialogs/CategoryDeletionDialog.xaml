<ContentDialog
    x:Class="EchoBoard.App.Dialogs.CategoryDeletionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Delete category?"
    PrimaryButtonText="Delete category"
    IsPrimaryButtonEnabled="{Binding CategoryDeletionSaveEnabled}"
    CloseButtonText="Cancel"
    DefaultButton="Close"
    PrimaryButtonClick="OnPrimaryButtonClick">
    <StackPanel MaxWidth="480" Spacing="{StaticResource EchoBoardSpace16}">
        <TextBlock
            Text="{Binding CategoryDeletionDescription}"
            Style="{StaticResource EchoBoardBodyTextStyle}" />
        <ComboBox
            Header="Move its sounds to"
            ItemsSource="{Binding CategoryDeletionDestinations}"
            SelectedItem="{Binding SelectedCategoryDeletionDestination, Mode=TwoWay}"
            DisplayMemberPath="Name" />
        <ProgressRing
            IsActive="{Binding IsCategoryDeletionSaving}"
            IsIndeterminate="True"
            HorizontalAlignment="Center"
            Visibility="{Binding CategoryDeletionSavingVisibility}" />
        <TextBlock
            Text="{Binding CategoryDeletionError}"
            Foreground="{ThemeResource EchoBoardErrorBrush}"
            TextWrapping="Wrap"
            Visibility="{Binding CategoryDeletionErrorVisibility}" />
    </StackPanel>
</ContentDialog>
